# Copy to .env (git-ignored) to change settings on your machine. Every setting but the database URL has
# a safe default.

# Required. postgresql://USER:PASSWORD@HOST:5432/DBNAME. docker compose sets it for the API container
# from POSTGRES_PASSWORD below, so you need it here only to run the service outside compose.
# LEDGERLENS_DATABASE_URL=

# dev | test | prod. prod turns off /docs and /openapi.json.
# LEDGERLENS_ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR
# LEDGERLENS_LOG_LEVEL=INFO

# The largest request body accepted, in bytes.
# LEDGERLENS_MAX_BODY_BYTES=1000000

# Read by docker compose, not by the service: the password of the compose stack's database. Make one with
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# POSTGRES_PASSWORD=
